<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- ── 헤더: 종합 분석 리포트 ──────────────────────── -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="발표 분석 리포트"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#1A237E"
            android:layout_marginBottom="20dp" />

        <!-- ── 종합 점수 섹션 ─────────────────────────────── -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="#E0E0E0"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp"
                android:gravity="center">

                <FrameLayout
                    android:layout_width="140dp"
                    android:layout_height="140dp"
                    android:background="@drawable/circle_score_bg"
                    android:gravity="center">
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:layout_gravity="center">
                        <TextView
                            android:id="@+id/tvScore"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="85"
                            android:textSize="48sp"
                            android:textStyle="bold"
                            android:textColor="#1A237E" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="SCORE"
                            android:textSize="12sp"
                            android:letterSpacing="0.1"
                            android:textColor="#7986CB" />
                    </LinearLayout>
                </FrameLayout>

                <TextView
                    android:id="@+id/tvDuration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="발표 시간: 05분 30초"
                    android:textSize="15sp"
                    android:textColor="#616161"
                    android:layout_marginTop="16dp" />

                <View
                    android:layout_width="40dp"
                    android:layout_height="2dp"
                    android:background="#E0E0E0"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="16dp" />

                <TextView
                    android:id="@+id/tvFeedback"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="AI 피드백 로딩 중..."
                    android:textSize="15sp"
                    android:textColor="#2C3E50"
                    android:lineSpacingExtra="6dp"
                    android:padding="16dp"
                    android:background="#F0F3FF"
                    android:drawablePadding="8dp"
                    app:drawableStartCompat="@android:drawable/ic_menu_info_details" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ── 상세 분석 섹션 타이틀 ───────────────────────── -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="상세 분석 항목"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#212121"
            android:layout_marginBottom="12dp"
            android:layout_marginStart="4dp"/>

        <!-- ── 스크립트 카드 ───────────────────────────────── -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            android:layout_marginBottom="16dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📄 전체 스크립트"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#1A237E" />
                <TextView
                    android:id="@+id/tvScript"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text=""
                    android:textSize="16sp"
                    android:textColor="#333333"
                    android:lineSpacingExtra="8dp"
                    android:padding="12dp"
                    android:background="#FAFAFA" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ── 속도 분석 카드 ──────────────────────────────── -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            android:layout_marginBottom="16dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚡ 말하기 속도 (WPM)"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#1A237E" />
                <TextView
                    android:id="@+id/tvSpeedSummary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="평균 135 WPM"
                    android:textSize="14sp"
                    android:textColor="#757575"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="16dp" />
                <com.github.mikephil.charting.charts.LineChart
                    android:id="@+id/chartWpm"
                    android:layout_width="match_parent"
                    android:layout_height="180dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ── 습관어 분석 카드 ────────────────────────────── -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            android:layout_marginBottom="16dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="💬 습관어 사용 빈도"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#1A237E" />
                <TextView
                    android:id="@+id/tvFillerSummary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="총 12회 감지됨"
                    android:textSize="14sp"
                    android:textColor="#757575"
                    android:layout_marginTop="4dp" />
                <TextView
                    android:id="@+id/tvFillerList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:padding="12dp"
                    android:background="#FFF9C4"
                    android:textSize="14sp"
                    android:textColor="#5D4037"
                    android:lineSpacingExtra="4dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ── 목소리 분석 카드 ────────────────────────────── -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            android:layout_marginBottom="24dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🎙 목소리 자신감 및 떨림"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#1A237E" />
                <TextView
                    android:id="@+id/tvVoiceSummary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="자신감 82% | 떨림 15%"
                    android:textSize="14sp"
                    android:textColor="#757575"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="16dp" />
                <com.github.mikephil.charting.charts.LineChart
                    android:id="@+id/chartVolume"
                    android:layout_width="match_parent"
                    android:layout_height="140dp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚠️ 목소리 떨림 구간"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#D32F2F"
                    android:layout_marginTop="20dp" />
                <TextView
                    android:id="@+id/tvTremorSections"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textSize="14sp"
                    android:textColor="#424242"
                    android:lineSpacingExtra="4dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
